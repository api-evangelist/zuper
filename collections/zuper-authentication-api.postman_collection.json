  "info": {
    "_postman_id": "68d50ef8-e53d-40c0-8da7-ba6d3399f33a",
    "name": "Zuper REST Authentication API",
    "description": "The Zuper REST API provides programmatic access to the Zuper field service management platform. It covers jobs, scheduling, route optimization, customers, organizations, assets, inventory, purchase orders, invoices, proposals, quotes, timesheets, projects, properties, service tasks, service contracts, webhooks, and communications. Authentication uses API keys passed via the x-api-key header. Region-specific base URLs are discovered by POSTing to the accounts endpoint.\n\nContact Support:\n Name: Zuper Developer Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:14:28.000Z",
    "updatedAt": "2026-10-22T01:14:28.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-68d50ef8-e53d-40c0-8da7-ba6d3399f33a"
  },
  "item": [
    {
      "name": "config",
      "item": [
        {
          "name": "Get Region-Specific Base URL",
          "id": "da5ed52a-d2c8-4827-ac0a-e35070b27b6f",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_login\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "config"
              ]
            },
            "description": "POST your company login name to discover the dc_api_url (region-specific base URL) for all subsequent API calls. Must target https://accounts.zuperpro.com/api."
          },
          "response": [
            {
              "id": "84175340-2718-4853-b43c-e9510c712fda",
              "name": "Configuration details including dc_api_url",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "description": "Added as a part of security scheme: apikey",
                    "key": "x-api-key",
                    "value": "<API Key>"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"company_login\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/config",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "config"
                  ]
                }
              },
              "status": "OK",
