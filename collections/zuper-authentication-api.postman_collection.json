{
  "item": [
    {
      "id": "b8e66cc7-967a-4d21-af37-743e7456d9df",
      "name": "Authentication",
      "description": {
        "content": "API key generation and base URL discovery",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a1de617f-af9b-49a8-96b8-77109c02e773",
          "name": "Get Region-Specific Base URL",
          "request": {
            "name": "Get Region-Specific Base URL",
            "description": {
              "content": "POST your company login name to discover the dc_api_url (region-specific base URL) for all subsequent API calls. Must target https://accounts.zuperpro.com/api.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "config"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Data-center region identifier returned by the config endpoint",
                  "type": "any",
                  "value": "{{dc_region}}",
                  "key": "dc_region"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_login\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "60df082d-afeb-40bc-bb81-f49167009763",
              "name": "Configuration details including dc_api_url",
              "originalRequest": {
                "url": {
                  "path": [
                    "config"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Data-center region identifier returned by the config endpoint",
                      "type": "any",
                      "value": "{{dc_region}}",
                      "key": "dc_region"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "x-api-key",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"company_login\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"dc_api_url\": \"string\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "description": {
        "content": "Data-center region identifier returned by the config endpoint",
        "type": "text/plain"
      },
      "type": "any",
      "value": "us1",
      "key": "dc_region"
    },
    {
      "type": "string",
      "value": "https://{{dc_region}}.zuperpro.com/api",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "info": {
    "_postman_id": "f5ae3db4-aeba-49ef-8dc2-7e0ad0c2f976",
    "name": "Zuper REST Assets Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Zuper REST API provides programmatic access to the Zuper field service management platform. It covers jobs, scheduling, route optimization, customers, organizations, assets, inventory, purchase orders, invoices, proposals, quotes, timesheets, projects, properties, service tasks, service contracts, webhooks, and communications. Authentication uses API keys passed via the x-api-key header. Region-specific base URLs are discovered by POSTing to the accounts endpoint.\n\nContact Support:\n Name: Zuper Developer Support",
      "type": "text/plain"
    }
  }
}