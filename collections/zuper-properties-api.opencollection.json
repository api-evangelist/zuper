{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zuper REST Assets Properties API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Properties",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Properties",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{dc_region}.zuperpro.com/api/properties",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-based)"
              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "Number of records per page (max 1000)"
              }
            ]
          },
          "docs": "Retrieve a paginated list of properties."
        },
        {
          "info": {
            "name": "Create Property",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{dc_region}.zuperpro.com/api/properties",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new property record."
        },
        {
          "info": {
            "name": "Get Property Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{dc_region}.zuperpro.com/api/properties/:property_uid",
            "params": [
              {
                "name": "property_uid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve details for a specific property."
        },
        {
          "info": {
            "name": "Update Property Details",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{dc_region}.zuperpro.com/api/properties/:property_uid",
            "params": [
              {
                "name": "property_uid",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing property record."
        },
        {
          "info": {
            "name": "Delete Property",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{dc_region}.zuperpro.com/api/properties/:property_uid",
            "params": [
              {
                "name": "property_uid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a property record."
        }
      ]
    }
  ],
  "bundled": true
}