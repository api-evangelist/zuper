                "name": "job_uid",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing job record."
        },
        {
          "info": {
            "name": "Delete a Job",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{dc_region}.zuperpro.com/api/jobs/:job_uid",
            "params": [
              {
                "name": "job_uid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a job record."
