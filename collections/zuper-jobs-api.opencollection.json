              },
              {
                "name": "filter.priority",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter.customer",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter.category",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter.keyword",
