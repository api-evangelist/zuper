{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zuper REST Assets Projects API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{dc_region}.zuperpro.com/api/projects",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-based)"
              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "Number of records per page (max 1000)"
              }
            ]
          },
          "docs": "Retrieve a paginated list of projects."
        },
        {
          "info": {
            "name": "Create Project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{dc_region}.zuperpro.com/api/projects",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new project."
        },
        {
          "info": {
            "name": "Get Project Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{dc_region}.zuperpro.com/api/projects/:project_uid",
            "params": [
              {
                "name": "project_uid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve details of a specific project."
        },
        {
          "info": {
            "name": "Update a Project",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{dc_region}.zuperpro.com/api/projects/:project_uid",
            "params": [
              {
                "name": "project_uid",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing project."
        },
        {
          "info": {
            "name": "Delete Project",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{dc_region}.zuperpro.com/api/projects/:project_uid",
            "params": [
              {
                "name": "project_uid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a project record."
        }
      ]
    }
  ],
  "bundled": true
}